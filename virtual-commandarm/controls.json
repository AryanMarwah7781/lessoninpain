{
  "about": "Every CommandARM input the Apr 20 Connections app (3.2.0.7) reads, decoded from its code. One source of truth for the virtual armrest, the tests, the lesson files and the simulator API. Evidence: re/apr20-connections/reports/01-app-controls.md section 3.1.",
  "build": "Apr 20 2026, Online - Display and CommandARM Simulator 3.2.0.7",
  "legend": {
    "dest": {
      "cloud": "sent to the cloud machine simulator (logged as SendVIOData ... Queue: /queue/COMMANDARM)",
      "game": "written only to the game file VehicleInfo.xml for Farming Simulator 25",
      "local": "changes how the app reads other controls; never sent anywhere",
      "none": "the app reads it but never sends it anywhere"
    },
    "certainty": {
      "named": "operator name confirmed by the app's own screens or procedures",
      "inferred": "name guessed from the signal name; confirm on the real armrest",
      "unknown": "purpose unknown"
    }
  },
  "modules": [
    { "id": "mhc", "name": "Multi-function handle", "msg": 124, "pressed": 1, "released": 0,
      "keys": ["v1","b1","c1","d1","e1","f1","g1","h1","i1","j1","k1","l1","m1","n1","o1","p1","q1","r1","s1","t1","u1","y0","y1","y2","z1"] },
    { "id": "scm", "name": "Armrest keypad", "msg": 125, "pressed": 2, "released": 1,
      "keys": ["1a","2a","3a","4a","5a","6a","7a","8a","9a","eb","ep","1c","2c","3c","4c","5c","6c","7c","8c","9c"] },
    { "id": "dcm", "name": "Keys beside the display", "msg": 123, "pressed": 2, "released": 1,
      "keys": ["b1","b2","b3","b4","b5","b6","b7","b8","b9","b10","b11","b12","b13","b14","e1","e2","lb"] },
    { "id": "hydro", "name": "Multi-function lever", "msg": 126 },
    { "id": "steer", "name": "Steering wheel", "msg": 119 },
    { "id": "pedals", "name": "Foot switch", "msg": 120 }
  ],
  "controls": [
    { "id": "master_spray", "label": "Master spray", "module": "mhc", "key": "b1", "kind": "button", "dest": "cloud", "vio": "PLT_MHC_MasterSprayOnOff", "certainty": "named", "note": "Yellow button on the handle. Step 4 of the app's Begin Spraying procedure." },
    { "id": "left_boom_raise", "label": "Left boom raise", "module": "mhc", "key": "c1", "kind": "button", "dest": "cloud", "vio": "PLT_MHC_LeftBoomRaise", "certainty": "named" },
    { "id": "left_boom_lower", "label": "Left boom lower", "module": "mhc", "key": "f1", "kind": "button", "dest": "cloud", "vio": "PLT_MHC_LeftBoomLower", "certainty": "named" },
    { "id": "right_boom_raise", "label": "Right boom raise", "module": "mhc", "key": "d1", "kind": "button", "dest": "cloud", "vio": "PLT_MHC_RightBoomRaise", "certainty": "named" },
    { "id": "right_boom_lower", "label": "Right boom lower", "module": "mhc", "key": "e1", "kind": "button", "dest": "cloud", "vio": "PLT_MHC_RightBoomLower", "certainty": "named" },
    { "id": "centre_boom_raise", "label": "Centre boom raise", "module": "mhc", "key": "j1", "kind": "button", "dest": "cloud", "vio": "PLT_MHC_CenterBoomRaise", "certainty": "named", "withFootSwitch": { "game": "boomUnfolded", "value": "0", "meaning": "folds the boom; nothing goes to the cloud" } },
    { "id": "centre_boom_lower", "label": "Centre boom lower", "module": "mhc", "key": "l1", "kind": "button", "dest": "cloud", "vio": "PLT_MHC_CenterBoomLower", "certainty": "named", "withFootSwitch": { "game": "boomUnfolded", "value": "1", "meaning": "unfolds the boom; nothing goes to the cloud" } },
    { "id": "section_right_enable", "label": "Boom sections right", "module": "mhc", "key": "g1", "kind": "button", "dest": "cloud", "vio": "PLT_MHC_IBSRightEnable", "certainty": "inferred", "note": "IBS right enable; probably shuts boom sections off from the outside in." },
    { "id": "section_left_enable", "label": "Boom sections left", "module": "mhc", "key": "h1", "kind": "button", "dest": "cloud", "vio": "PLT_MHC_IBSLeftEnable", "certainty": "inferred" },
