<UserControl x:Class="LessonPanel.Controls.HandleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The manual's lettered multi-function lever drawing (612R manual NX707642) with rings on the buttons to press.
         Zooms to the front or side view when every target is on it. -->
    <Viewbox Stretch="Uniform">
        <Border x:Name="Crop" Width="1000" Height="600" ClipToBounds="True">
            <Grid x:Name="Stage" Width="1000" Height="600" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.RenderTransform><TranslateTransform x:Name="Pan"/></Grid.RenderTransform>
                <Image x:Name="Figure" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Canvas x:Name="Overlay" IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </Viewbox>
</UserControl>
