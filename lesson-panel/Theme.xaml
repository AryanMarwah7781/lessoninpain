<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The Connections app's own visual world (colours and Calibri read from its compiled XAML, 3 Nov 2026):
         white title band with the green and yellow edge stripe, grey ground, white cards, yellow for the main action. -->
    <Color x:Key="GreenColor">#367C2B</Color>
    <Color x:Key="GreenBrightColor">#32933A</Color>
    <Color x:Key="YellowColor">#FFDE00</Color>
    <Color x:Key="YellowDeepColor">#F0BD12</Color>
    <Color x:Key="InkColor">#282828</Color>
    <Color x:Key="MutedColor">#5F5F5F</Color>
    <Color x:Key="FaintColor">#8A8A8A</Color>
    <Color x:Key="LineColor">#D0D0D0</Color>
    <Color x:Key="GroundColor">#E6E6E6</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="SoftColor">#F1F1F1</Color>
    <Color x:Key="GreenSoftColor">#E4F0E1</Color>
    <Color x:Key="YellowSoftColor">#FFF8CC</Color>
    <Color x:Key="ErrorColor">#B3261E</Color>
    <Color x:Key="ErrorInkColor">#8A1F17</Color>
    <Color x:Key="ErrorSoftColor">#FDECEB</Color>
    <Color x:Key="DisplayColor">#1D1D1D</Color>

    <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="GreenBright" Color="{StaticResource GreenBrightColor}"/>
    <SolidColorBrush x:Key="Yellow" Color="{StaticResource YellowColor}"/>
    <SolidColorBrush x:Key="YellowDeep" Color="{StaticResource YellowDeepColor}"/>
    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="Faint" Color="{StaticResource FaintColor}"/>
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="Ground" Color="{StaticResource GroundColor}"/>
    <SolidColorBrush x:Key="Card" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="Soft" Color="{StaticResource SoftColor}"/>
    <SolidColorBrush x:Key="GreenSoft" Color="{StaticResource GreenSoftColor}"/>
    <SolidColorBrush x:Key="YellowSoft" Color="{StaticResource YellowSoftColor}"/>
    <SolidColorBrush x:Key="Error" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="ErrorInk" Color="{StaticResource ErrorInkColor}"/>
    <SolidColorBrush x:Key="ErrorSoft" Color="{StaticResource ErrorSoftColor}"/>
    <SolidColorBrush x:Key="DisplayGround" Color="{StaticResource DisplayColor}"/>

    <FontFamily x:Key="Face">Calibri, Segoe UI</FontFamily>
    <!-- Type scale for reading at arm's length on a second monitor. -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="TCaption">15</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="TLabel">17</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="TBody">21</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="TSub">26</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="TTitle">34</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="TAction">48</sys:Double>

    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TLabel}"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="PaneTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TLabel}"/>
        <Setter Property="Foreground" Value="{StaticResource Green}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="22,18"/>
    </Style>

    <!-- Buttons: standard WPF buttons restyled in the app's manner. Primary = the app's yellow action. -->
    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Face}"/>
        <Setter Property="FontSize" Value="{StaticResource TBody}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource Card}"/>
        <Setter Property="BorderBrush" Value="#9A9A9A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="24,11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="focus" CornerRadius="6" Margin="-4" BorderBrush="{StaticResource Ink}" BorderThickness="2" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Soft}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#E2E2E2"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A large choice tile, in the manner of the Connections app's "Select Platform" tiles: white card, green when chosen. -->
    <Style x:Key="ChoiceTile" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource Face}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="b" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="6" Padding="23,17">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid Width="22" Height="22" VerticalAlignment="Top" Margin="0,5,16,0">
                                    <Ellipse x:Name="ring" Stroke="#8A8A8A" StrokeThickness="2"/>
                                    <Ellipse x:Name="dot" Fill="{StaticResource Green}" Margin="5" Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter Grid.Column="1"/>
                            </Grid>
                        </Border>
                        <Border x:Name="focus" CornerRadius="8" Margin="-4" BorderBrush="{StaticResource Ink}" BorderThickness="2" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Soft}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource GreenSoft}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Green}"/>
                            <Setter TargetName="b" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="b" Property="Padding" Value="22,16"/>
                            <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Green}"/>
                            <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Visibility" Value="Visible"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Background" Value="{StaticResource Yellow}"/>
        <Setter Property="BorderBrush" Value="#D8BB00"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="focus" CornerRadius="6" Margin="-4" BorderBrush="{StaticResource Ink}" BorderThickness="2" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FFE733"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource YellowDeep}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
