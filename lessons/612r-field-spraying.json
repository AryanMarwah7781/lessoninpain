          "why": "Ready means HMS can be activated. With HMS OFF (gray), nothing changes when you press it.",
          "controls": [
            "display_hms_status"
          ],
          "done": {
            "confirm": "HMS shows Ready (green)"
          },
          "wrong": [
            {
              "if": {
                "sent": "PLT_MHC_HMS",
                "eq": "1"
              },
              "say": "Too early: that ran the HMS entry in the crop. Press HMS only as you enter the headland."
            }
          ],
          "wrong_demo": [
            "press hms 300",
            "wait 0.4"
          ],
          "hints": [
            {
              "after_s": 20,
              "say": "The HMS status shows on its run page module or the HMS main page.",
              "highlight": [
                "display_hms_status"
              ]
            },
            {
              "after_s": 45,
              "say": "Display: Menu, Machine Settings, Headland Management System. Gray is OFF, green is Ready, blue is Active.",
              "highlight": [
                "display_hms_status"
              ]
            }
          ],
          "ask": "What is HMS set to do on this machine?",
          "est_s": 50,
