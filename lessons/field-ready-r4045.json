    "armrest": [
      "switch foot_switch 0",
      "switch park_slot 1",
      "set steering 0",
      "set speed_dial 0",
      "switch foot_switch 1",
      "wait 0.3",
      "press centre_boom_raise 600",
      "wait 0.3",
      "switch foot_switch 0",
      "wait 0.5"
    ],
    "trainer": "Start with the lever in the park slot, the wheel straight, the boom folded (hold the foot switch and press Centre boom raise), the ladder down and the game camera on view 1.",
    "expect": {
      "game": {
        "boomUnfolded": "0",
        "ladderRaised": "0",
        "cameraView": "1"
      }
    }
  },
  "chatbot": {
